{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowJs": true,
    "types": ["bun"],

    // Path alias — @/ aponta para a raiz do projeto
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    // Desligado: o catálogo i18n (`Messages = Record<string,string>`) e os
    // acessos indexados seguros do app tornam `t.foo`/`arr[0]` em
    // `T | undefined` sob esta flag, gerando ruído em massa sem valor real.
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "exclude": ["packages", "dist", "node_modules"]
}
