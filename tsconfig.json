{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowJs": true,
    "types": ["bun"],

    // Um alias por camada do MVVM: o import declara a camada de destino, então
    // toda violação da regra de dependência (pages → view → viewmodel → model)
    // fica visível no próprio specifier — e é barrada pelo eslint.
    // `@/paraglide/*` é caso à parte: saída de compilador, mora em `dist/`.
    // Os específicos precisam vir ANTES de `@/*`.
    "baseUrl": ".",
    "paths": {
      "@model/*": ["./src/model/*"],
      "@viewmodel/*": ["./src/viewmodel/*"],
      "@view/*": ["./src/view/*"],
      "@testing/*": ["./src/testing/*"],
      "@/paraglide/*": ["./dist/paraglide/*"],
      "@/*": ["./*"]
    },

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    // Desligado: o catálogo i18n (`Messages = Record<string,string>`) e os
    // acessos indexados seguros do app tornam `t.foo`/`arr[0]` em
    // `T | undefined` sob esta flag, gerando ruído em massa sem valor real.
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // `src/model` deixou de ser um package pré-compilado e passa a ser typechecado
  // junto do app — é o ganho de dissolver o SDK. Só o submodule de contrato
  // (JSON/fbs, sem TS) e os packages externos ficam de fora.
  "exclude": ["packages", "dist", "node_modules", "src/model/contract"]
}
