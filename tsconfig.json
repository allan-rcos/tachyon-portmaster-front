{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "allowJs": true,
    "types": ["bun"],

    // Um alias por camada do MVVM: o import declara a camada de destino, então
    // toda violação da regra de dependência (pages → view → viewmodel → model)
    // fica visível no próprio specifier — e é barrada pelo eslint.
    // `@/paraglide/*` e `@/fbs/*` são casos à parte: saída de compilador
    // (paraglide-js e flatc), moram em `dist/` e não versionam.
    // Os específicos precisam vir ANTES de `@/*`.
    "baseUrl": ".",
    "paths": {
      "@model/*": ["./src/model/*"],
      "@viewmodel/*": ["./src/viewmodel/*"],
      "@view/*": ["./src/view/*"],
      "@/paraglide/*": ["./dist/paraglide/*"],
      "@/fbs/*": ["./dist/fbs/*"],
      "@/*": ["./*"]
    },

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    // Ligado: com os catálogos i18n tipados por interface (e não mais
    // `Record<string,string>`), a flag deixou de gerar ruído e passou a pegar
    // coisa real — entre elas `getContainerSummary` devolvendo `undefined`
    // tipado como `ContainerSummary` quando o contêiner não existe.
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  // `src/model` deixou de ser um package pré-compilado e passa a ser typechecado
  // junto do app — é o ganho de dissolver o SDK. Só o submodule de contrato
  // (JSON/fbs, sem TS) e os packages externos ficam de fora.
  "exclude": ["packages", "dist", "node_modules", "src/model/contract"]
}
