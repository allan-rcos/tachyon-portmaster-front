# dependencies (bun install)
node_modules

# output
out
dist
*.tgz

# gerado por comando (codegen) — regenerável no build, nada aqui é fonte.
# Ambas as saídas vivem em `dist/`, já coberto acima:
#   • dist/paraglide — funções `m.*` tree-shakeable do Paraglide (i18n:compile)
#   • dist/fbs       — bindings do FlatBuffers (gen:fbs, exige `flatc`)
# `gen` (gen:fbs + gen:css) é pré-passo de `dev`/`build`/`test`/`typecheck`,
# então o gerado nunca precisa ser commitado — e não pode divergir da fonte.

# Tipos exatos dos CSS Modules (gen:css). Ficam ao LADO do .scss porque é assim
# que o TypeScript resolve `import styles from './x.module.scss'` — não dá para
# jogá-los em dist/.
*.module.scss.d.ts

# API reference gerada pelo TypeDoc (regenerável: bun run docs:api)
docs/api

# code coverage
coverage
*.lcov

# logs
logs
_.log
report.[0-9]_.[0-9]_.[0-9]_.[0-9]_.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# caches
.eslintcache
.cache
*.tsbuildinfo

