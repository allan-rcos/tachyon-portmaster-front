{
  "name": "portmaster",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^9.17.0",
    "@faker-js/faker": "^10.5.0",
    "@inlang/paraglide-js": "^2.22.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "latest",
    "ajv": "^8.17.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.2.2",
    "eslint-plugin-solid": "^0.14.5",
    "fishery": "^2.4.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "sass": "^1.101.0",
    "typed-scss-modules": "^8.1.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript-eslint": "^8.64.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.10",
    "vitest-mock-extended": "^5.1.0",
    "zod-schema-faker": "^2.1.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@tanstack/solid-form": "^1.33.2",
    "alien-signals": "^3.2.1",
    "date-fns": "^4.4.0",
    "flatbuffers": "^25.9.23",
    "numbro": "^2.5.0",
    "ofetch": "^1.4.1",
    "solid-js": "^1.9.14",
    "tachyon-design": "workspace:*",
    "vike": "^0.4.260",
    "vike-solid": "^0.8.3",
    "vike-txiki-adapter": "workspace:*",
    "vite": "^8.1.0",
    "zod": "^4.4.3"
  },
  "scripts": {
    "dev": "bun run gen && vite",
    "build:adapter": "bun run --filter vike-txiki-adapter build",
    "build": "bun run build:adapter && bun run gen && bun run i18n:compile && bunx --bun vite build",
    "typecheck": "bun run gen && tsc --noEmit",
    "docs:api": "typedoc",
    "gen": "bun run gen:fbs && bun run gen:css",
    "gen:css": "typed-scss-modules \"src/**/*.module.scss\" --nameFormat none --exportType default --aliasPrefixes.@ds/ packages/tachyon-design/scss/ --logLevel error",
    "gen:fbs": "flatc --ts --gen-object-api --gen-all -o dist/fbs src/model/contract/swagger/flatbuffers/schemas/api.fbs",
    "i18n:compile": "paraglide-js compile --project ./packages/tachyon-portmaster-i18n/project.inlang --outdir ./dist/paraglide --strategy baseLocale --emit-ts-declarations --is-server \"typeof window === 'undefined'\"",
    "i18n:check": "node packages/tachyon-portmaster-i18n/bin/i18n-check.mjs",
    "start": "vike-txiki-adapter start",
    "test": "bun run gen && vitest run",
    "test:watch": "bun run gen && vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  }
}
