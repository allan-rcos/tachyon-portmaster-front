{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portmaster.app/i18n/form/product.json",
  "title": "i18n do formulário de produto (productFormMessages)",
  "type": "object",
  "allOf": [
    { "$ref": "https://portmaster.app/i18n/common.json" },
    { "$ref": "https://portmaster.app/i18n/val.json" }
  ],
  "required": [
    "products_data",
    "products_name",
    "products_density",
    "products_risk_class",
    "products_delete_confirm"
  ],
  "patternProperties": {
    "^products_": { "type": "string", "minLength": 1 }
  }
}
