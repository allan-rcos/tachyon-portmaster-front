{
  "name": "vike-lit",
  "version": "0.1.0",
  "description": "Integração de Lit no Vike: onRenderHtml/onRenderClient com @lit-labs/ssr, espelhando a arquitetura do vike-solid.",
  "type": "module",
  "license": "MIT",
  "keywords": ["vike", "lit", "lit-html", "ssr", "hydration"],
  "exports": {
    "./config": {
      "types": "./dist/+config.d.ts",
      "default": "./dist/+config.js"
    },
    "./ClientOnly": {
      "types": "./dist/components/ClientOnly.d.ts",
      "default": "./dist/components/ClientOnly.js"
    },
    "./types": {
      "types": "./dist/types/Config.d.ts",
      "default": "./dist/types/Config.js"
    },
    "./__internal/integration/onRenderHtml": {
      "types": "./dist/integration/onRenderHtml.d.ts",
      "default": "./dist/integration/onRenderHtml.js"
    },
    "./__internal/integration/onRenderClient": {
      "types": "./dist/integration/onRenderClient.d.ts",
      "default": "./dist/integration/onRenderClient.js"
    }
  },
  "typesVersions": {
    "*": {
      "config": ["dist/+config.d.ts"],
      "ClientOnly": ["dist/components/ClientOnly.d.ts"],
      "types": ["dist/types/Config.d.ts"]
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "prepare": "bun run build"
  },
  "dependencies": {
    "isbot-fast": "^1.2.0"
  },
  "peerDependencies": {
    "@lit-labs/ssr": "^4.1.0",
    "@lit-labs/ssr-client": "^1.1.8",
    "alien-signals": "^3.2.1",
    "lit": "^3.3.3",
    "vike": ">=0.4.250"
  },
  "devDependencies": {
    "typescript": "^5"
  }
}
