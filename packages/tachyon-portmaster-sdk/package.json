{
  "name": "tachyon-portmaster-sdk",
  "version": "0.1.0",
  "description": "SDK TS-only de comunicação com a API do PortMaster (ofetch + negociação JSON/FlatBuffers). Puro: não conhece Vike/txiki — o app injeta baseURL, cookies e o formato de wire.",
  "type": "module",
  "license": "MIT",
  "keywords": ["portmaster", "sdk", "ofetch", "flatbuffers", "rest"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./core": { "types": "./dist/core/index.d.ts", "import": "./dist/core/index.js", "default": "./dist/core/index.js" },
    "./common": { "types": "./dist/common/index.d.ts", "import": "./dist/common/index.js", "default": "./dist/common/index.js" },
    "./auth": { "types": "./dist/auth/index.d.ts", "import": "./dist/auth/index.js", "default": "./dist/auth/index.js" },
    "./account": { "types": "./dist/account/index.d.ts", "import": "./dist/account/index.js", "default": "./dist/account/index.js" },
    "./users": { "types": "./dist/users/index.d.ts", "import": "./dist/users/index.js", "default": "./dist/users/index.js" },
    "./roles": { "types": "./dist/roles/index.d.ts", "import": "./dist/roles/index.js", "default": "./dist/roles/index.js" },
    "./products": { "types": "./dist/products/index.d.ts", "import": "./dist/products/index.js", "default": "./dist/products/index.js" },
    "./containers": { "types": "./dist/containers/index.d.ts", "import": "./dist/containers/index.js", "default": "./dist/containers/index.js" },
    "./metrics": { "types": "./dist/metrics/index.d.ts", "import": "./dist/metrics/index.js", "default": "./dist/metrics/index.js" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "bun build src/index.ts src/core/index.ts src/common/index.ts src/auth/index.ts src/account/index.ts src/users/index.ts src/roles/index.ts src/products/index.ts src/containers/index.ts src/metrics/index.ts --outdir dist --root src --splitting --target node --format esm --packages external && tsc --emitDeclarationOnly",
    "gen:fbs": "flatc --ts --gen-object-api --gen-all -o src/fbs-gen ../../swagger/flatbuffers/schemas/api.fbs",
    "prepare": "bun run build"
  },
  "dependencies": {
    "flatbuffers": "^25.9.23",
    "ofetch": "^1.4.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
