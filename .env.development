# Ambiente de desenvolvimento (bun run dev / vite).
# Em dev o wire é JSON (import.meta.env.PROD === false).

# Browser → API. Em dev não há Nginx; configure um proxy /api no vite.config
# (ou aponte direto para o backend swagger) conforme o ambiente local.
PUBLIC_ENV__API_BASE_URL=/api

# Server (loaders) → Rust, loopback.
PUBLIC_ENV__API_SERVER_URL=http://127.0.0.1:8080
